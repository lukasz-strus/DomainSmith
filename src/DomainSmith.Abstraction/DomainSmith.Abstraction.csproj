<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
	    <TargetFramework>netstandard2.0</TargetFramework>
	    <ImplicitUsings>enable</ImplicitUsings>
	    <Nullable>enable</Nullable>
	    <LangVersion>latest</LangVersion>
	    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	    <IsPackable>true</IsPackable>
	    <PackageId>DomainSmith.Abstraction</PackageId>
	    <Authors>Łukasz Strus</Authors>
	    <PackageLicenseExpression>MIT</PackageLicenseExpression>
	    <PackageIcon>icon.png</PackageIcon>
	    <PackageDescription>Roslyn Source Generator for .NET that automates Domain-Driven Design patterns and Clean Architecture components.</PackageDescription>
	    <RepositoryUrl>https://github.com/Nairda015/GenWrap</RepositoryUrl>
	    <PackageTags>ddd;source-generators;clean-architecture</PackageTags>
	    <Title>Source-generated extensions for Domain-Driven Design</Title>
	    <PackageReadmeFile>README.md</PackageReadmeFile>
	    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
		<PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.0.0" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="DomainSmith.Abstraction.Tests" />
		<InternalsVisibleTo Include="DomainSmith.Entity" />
		<InternalsVisibleTo Include="DomainSmith.ValueObject" />
		<InternalsVisibleTo Include="DomainSmith.AggregateRoot" />
		<InternalsVisibleTo Include="DomainSmith.Repository" />
		<InternalsVisibleTo Include="DomainSmith.Entity.Tests" />
		<InternalsVisibleTo Include="DomainSmith.ValueObject.Tests" />
		<InternalsVisibleTo Include="DomainSmith.AggregateRoot.Tests" />
		<InternalsVisibleTo Include="DomainSmith.Repository.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
		<None Include="../../README.md" Pack="true" PackagePath="/" />
		<None Include="../../icon.png" Pack="true" PackagePath="/" />
	</ItemGroup>

</Project>
